{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "whatsapp-bot/**"
    ],
    "headers": [
      { "source": "*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
    ],
    "rewrites": [
      { "source": "/api/**", "function": "adminChat" },
      { "source": "/api/charge/**", "function": "yocoCharge" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules",
    "target": "rules"
  },
  "functions": [
    { "source": "functions", "codebase": "default", "ignore": ["node_modules"] }
  ]
}
