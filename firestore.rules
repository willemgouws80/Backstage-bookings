rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bookings — public write, admin read
    match /bookings/{doc} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    // Courses — public read, admin write
    match /courses/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Site config — public read, admin write (powers the public website)
    match /siteConfig/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Analytics — public read/write (page view counter)
    match /analytics/{doc} {
      allow read, write: if true;
    }
    // Admin-only collections
    match /invoices/{doc} {
      allow read, write: if request.auth != null;
    }
    match /quotes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /attendance/{doc} {
      allow read, write: if request.auth != null;
    }
    match /studentNotes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /resources/{doc} {
      allow read, write: if request.auth != null;
    }
    match /promotions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /announcements/{doc} {
      allow read, write: if request.auth != null;
    }
    // Admin secrets — Yoco/stripe keys, admin-only
    match /admin/{doc} {
      allow read, write: if request.auth != null;
    }
    // Practice sessions — student writes own, admin reads all
    match /practiceSessions/{doc} {
      allow read: if request.auth != null && (request.auth.token.email == resource.data.email || request.auth.token.email == 'willemgouws80@gmail.com');
      allow create: if request.auth != null && request.auth.token.email == request.resource.data.email;
      allow update, delete: if request.auth != null && request.auth.token.email == resource.data.email;
    }
    // Lessons (recurring generated) — admin writes, student reads own
    match /lessons/{doc} {
      allow read: if request.auth != null && (request.auth.token.email == resource.data.email || request.auth.uid != null);
      allow write: if request.auth != null;
    }
    // Repertoire — student reads/writes own, admin reads all
    match /repertoire/{doc} {
      allow read: if request.auth != null && (request.auth.token.email == resource.data.email || request.auth.uid != null);
      allow create: if request.auth != null && request.auth.token.email == request.resource.data.email;
      allow update, delete: if request.auth != null && request.auth.token.email == resource.data.email;
    }
    // Everything else — admin only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
