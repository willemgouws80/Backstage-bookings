rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bookings — public write, admin read
    match /bookings/{doc} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    // Courses — public read, admin write
    match /courses/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Site config — public read, admin write (powers the public website)
    match /siteConfig/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Analytics — public read/write (page view counter)
    match /analytics/{doc} {
      allow read, write: if true;
    }
    // Admin-only collections
    match /invoices/{doc} {
      allow read, write: if request.auth != null;
    }
    match /quotes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /attendance/{doc} {
      allow read, write: if request.auth != null;
    }
    match /studentNotes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /resources/{doc} {
      allow read, write: if request.auth != null;
    }
    match /promotions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /announcements/{doc} {
      allow read, write: if request.auth != null;
    }
    // Everything else — admin only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
